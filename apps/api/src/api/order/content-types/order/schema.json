{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "buyerName": { "type": "string", "required": true },
    "amount": { "type": "integer", "required": true, "min": 0 },
    "status": {
      "type": "enumeration",
      "enum": ["owed", "paid", "collected", "cancelled"],
      "default": "owed"
    },
    "shop": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::shop.shop",
      "inversedBy": "orders"
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product"
    },
    "receipt": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}
